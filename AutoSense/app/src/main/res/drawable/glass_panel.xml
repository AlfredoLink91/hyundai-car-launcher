<?xml version="1.0" encoding="utf-8"?>
<!-- Efecto "vidrio" tipo Windows 7: relleno translúcido más claro arriba y borde con brillo.
     Android 7 no tiene blur en tiempo real, así que el brillo se simula con el gradiente. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#4AFFFFFF"
        android:endColor="#0FFFFFFF"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
