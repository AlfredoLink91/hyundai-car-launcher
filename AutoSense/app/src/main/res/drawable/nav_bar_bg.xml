<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior: gris azulado oscuro, sin el borde brillante de las tarjetas -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#2A3A4D"
        android:endColor="#111B27"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#3D5570" />
</shape>
