<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_translucent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Barra superior: marca, hora y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo de Hyundai plateado -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="210dp"
                    android:layout_height="28dp"
                    android:contentDescription="Hyundai"
                    android:scaleType="fitStart"
                    android:src="@drawable/ic_hyundai_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0C4DE"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Clima (ícono a color, temperatura, sensación y lugar) + batería -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="40dp"
                    android:contentDescription="Clima"
                    android:src="@drawable/ic_wx_partly" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weather_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="220dp"
                        android:text="Sin datos de clima"
                        android:textColor="#B0C4DE"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#33FFFFFF" />

                <ImageView
                    android:id="@+id/bt_status"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Bluetooth"
                    android:src="@drawable/ic_bluetooth" />

                <com.autosense.launcher.WifiSignalView
                    android:id="@+id/wifi_signal"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Wi-Fi" />

                <com.autosense.launcher.BatteryView
                    android:id="@+id/battery"
                    android:contentDescription="Batería"
                    android:layout_width="34dp"
                    android:layout_height="18dp" />

                <TextView
                    android:id="@+id/battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="--%"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/power_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Apagar"
                    android:scaleType="center"
                    android:src="@drawable/ic_power" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contenido: navegación | auto + velocímetro | música -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Tarjeta de navegación: Waze (ícono grande) + indicación de Waze en vivo -->
            <FrameLayout
                android:id="@+id/nav_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_panel">

                <ImageView
                    android:id="@+id/nav_app_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:contentDescription="Waze. Toca para abrir la navegación"
                    android:scaleType="fitCenter" />

                <!-- Alternativa: modo manejo con Google Maps -->
                <LinearLayout
                    android:id="@+id/nav_maps"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/nav_banner"
                    android:contentDescription="Navegar con Google Maps"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:id="@+id/nav_maps_icon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Google Maps"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/nav_banner"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/nav_destino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Navegación"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nav_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Toca para navegar con Waze"
                        android:textColor="#B0C4DE"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Centro: saludo, auto y velocímetro -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <ImageView
                    android:id="@+id/car"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="Hyundai Accent 2017 rojo"
                    android:scaleType="fitCenter"
                    android:background="@drawable/radial_glow"
                    android:src="@drawable/car_accent" />

                <!-- Brillo y volumen: deslizadores finos sobre vidrio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brightness" />

                    <SeekBar
                        android:id="@+id/brightness_slider"
                        style="@style/QuickSlider"
                        android:contentDescription="Brillo de la pantalla" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="14dp"
                        android:background="#33FFFFFF" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_volume" />

                    <SeekBar
                        android:id="@+id/volume_slider"
                        style="@style/QuickSlider"
                        android:contentDescription="Volumen" />
                </LinearLayout>

                <com.autosense.launcher.SpeedGaugeView
                    android:id="@+id/speed_gauge"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginBottom="2dp" />
            </LinearLayout>

            <!-- Tarjeta de música -->
            <LinearLayout
                android:id="@+id/music_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Música"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/album_art"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="Portada"
                    android:scaleType="fitCenter"
                    android:padding="24dp"
                    android:src="@drawable/ic_music" />

                <TextView
                    android:id="@+id/track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Spotify"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Toca para abrir"
                    android:textColor="#B0C4DE"
                    android:textSize="13sp" />

                <!-- Progreso de la canción: arrastrar para adelantar o retroceder -->
                <SeekBar
                    android:id="@+id/track_seek"
                    style="@style/QuickSlider"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_weight="0"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Posición de la canción" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/track_elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#B0C4DE"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/track_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-0:00"
                        android:textColor="#B0C4DE"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/music_prev"
                        style="@style/MediaButton"
                        android:contentDescription="Canción anterior"
                        android:src="@drawable/ic_skip_prev" />

                    <ImageView
                        android:id="@+id/music_play"
                        style="@style/MediaButton"
                        android:contentDescription="Reproducir o pausar"
                        android:src="@drawable/ic_play_pause" />

                    <ImageView
                        android:id="@+id/music_next"
                        style="@style/MediaButton"
                        android:contentDescription="Siguiente canción"
                        android:src="@drawable/ic_skip_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Barra inferior -->
        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nav_bar_bg"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_home"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_home"
                android:text="Home" />

            <TextView
                android:id="@+id/tab_mapa"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_map"
                android:text="Mapa" />

            <TextView
                android:id="@+id/tab_musica"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_music"
                android:text="Música" />

            <TextView
                android:id="@+id/tab_telefono"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_phone"
                android:text="Teléfono" />

            <TextView
                android:id="@+id/tab_camara"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_camera"
                android:text="Cámara" />

            <TextView
                android:id="@+id/tab_ajustes"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_settings"
                android:text="Ajustes" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/NavTab"
                android:drawableTop="@drawable/ic_apps"
                android:text="Apps" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
